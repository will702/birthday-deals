# Neon Postgres. DATABASE_URL = pooled connection string (used at runtime).
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
# DATABASE_URL_UNPOOLED = direct (non-pooled) connection string, used by Prisma for migrations/db push.
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"
# Admin token required (via x-admin-token header) by /api/deals/[slug]/moderate and /api/scraper/run.
# REQUIRED: if unset or empty, these routes always respond 401 (fail-closed).
ADMIN_TOKEN=""
# Contact URL included in the scraper User-Agent: "BirthdayDealsBot/1.0 (+<url>)"
SCRAPER_CONTACT_URL=""
# Minimum delay in ms between requests to the same host (default 1000)
# SCRAPER_MIN_DELAY_MS=1000
# Agentic scraper (opt-in: npm run scrape -- --source=agentic). Skipped when no key is set.
# Vercel AI Gateway key
# AI_GATEWAY_API_KEY=""
# Gateway model id used for extraction and the agent (default: anthropic/claude-haiku-5-5)
# SCRAPER_AI_MODEL="anthropic/claude-haiku-5-5"
# Default search topic for the agent (default: "promo ulang tahun gratis"); CLI: --query="..."
# SCRAPER_AGENT_QUERY="promo ulang tahun gratis"
# Comma-separated seed URLs for the agent; CLI: --seeds=url1,url2
# SCRAPER_AGENT_SEEDS=""
# Optional: GitHub token for higher API rate limits
# GITHUB_TOKEN=""
# Better Auth. Secret also signs the anonymous visitor cookie (uid_anon). Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"
# Chat assistant, birthday-plan narrative and admin AI tools: gateway model id (default: anthropic/claude-haiku-5-5)
# CHAT_AI_MODEL="anthropic/claude-haiku-5-5"
# Recommender (optional)
# Embedding model via AI Gateway, must output 1536 dims (default: openai/text-embedding-3-small)
# EMBEDDING_MODEL="openai/text-embedding-3-small"
# Minimum positive interactions before collaborative filtering is enabled (default 50)
# RECO_CF_MIN=50
# Set to 1 to bypass the Neon WebSocket driver adapter and use plain TCP (port 5432).
# PRISMA_NO_ADAPTER=1
